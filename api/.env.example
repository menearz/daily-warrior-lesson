# Daily Warrior API: production values (non-secret, approved by Zachary 2026-10-13).
# Secrets are left blank; Harbor sets them from its secret store. Never commit them.
DW_API_HOST=127.0.0.1
DW_API_PORT=8787
DW_STORE_PATH=/var/lib/dw-api/dw-store.json
DW_ALLOWED_ORIGIN=https://menearz.github.io
DW_SITE_URL=https://menearz.github.io/daily-warrior-lesson
DW_PRICE_MONTHLY_CENTS=499
DW_PRICE_YEARLY_CENTS=3999
DW_SELLER_NAME='Ancilla Dynamic, LLC'
DW_SUPPORT_EMAIL=dailywarrior@agentmail.to
DW_MAIL_FROM='Daily Warrior <dailywarrior@agentmail.to>'
DW_REFUND_POLICY=webcopy-2026-10-13
# Launch: set to 1 only when the site flag is flipped too (see README).
DW_LAUNCH=
# Secrets (blank here). The API refuses to start with a sk_live_ key.
DW_STRIPE_SECRET_KEY=
DW_STRIPE_WEBHOOK_SECRET=
DW_STRIPE_PRICE_MONTHLY=
DW_STRIPE_PRICE_YEARLY=
DW_AGENTMAIL_API_KEY=
DW_AGENTMAIL_INBOX_ID=dailywarrior@agentmail.to

# Owner/test override (OFF unless set). Comma-separated emails that count as
# subscribed without paying, for end-to-end testing only. The API refuses to
# start with this set unless DW_SITE_URL is 127.0.0.1/localhost and DW_LAUNCH
# is off, so it cannot be on in production. Leave empty on Harbor.
DW_TEST_OVERRIDE_EMAILS=
# Lessons catalog for subscriber lessons (default: ../lessons.json in this repo).
DW_LESSONS_PATH=
# Free access, safe in production. Owners default to Zachary's two addresses.
DW_OWNER_EMAILS=menearz@gmail.com,menearz@yahoo.com
# Testers get free entitled access and a Tester badge. Empty by default.
TESTER_EMAILS=
# Paywall. Unset or 0: every signed-in account gets lessons, the 12 questions, and a personalized path.
# Set to 1 to restore subscriber gating (402 without an active plan).
DW_PAYWALL_ENABLED=
